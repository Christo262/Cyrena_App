@using Cyrena.Desktop.Models
@using Cyrena.Desktop.Services
@inject ISettingsService _settings
@inject ISetupService _setup
@inject IBrowserService _web

<h4>Default AI Connection</h4>
<hr />

<ConnectionSelector @bind-Value="@_model.DefaultConnectionId" Label="Default AI Connection" @bind-Value:after="OnValueChanged"></ConnectionSelector>

<button type="button" class="btn btn-primary" @onclick="Test">Test</button>

@code {
    private WindowOptions _model = default!;
    protected override void OnInitialized()
    {
        _model = _settings.Read<WindowOptions>(WindowOptions.Key) ?? new WindowOptions();
    }

    private void OnValueChanged()
    {
        _settings.Save<WindowOptions>(WindowOptions.Key, _model);
        _setup.InvokeDefaultConnectionSet();
    }

    private void Test()
    {
        _web.OpenUri(new("https://vayanova.co.za"));
    }
}