@namespace BlazorApp.Components.Pages
@page "/bug-report"
@inject IBugReportEmailService EmailService

<div class="bug-report-container">
    <h1>Bug Report</h1>

    <p>Found an issue? Let us know by filling out the form below.</p>

    <EditForm Model="bugReport" OnValidSubmit="SubmitBugReport">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="title">Title</label>
            <InputText id="title" class="form-control" @bind-Value="bugReport.Title" />
            <ValidationMessage For="@(() => bugReport.Title)" />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <InputTextArea id="description" class="form-control" @bind-Value="bugReport.Description" />
            <ValidationMessage For="@(() => bugReport.Description)" />
        </div>

        <div class="form-group">
            <label for="severity">Severity</label>
            <InputSelect id="severity" class="form-control" @bind-Value="bugReport.Severity">
                <option value="">-- Select Severity --</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>
            </InputSelect>
            <ValidationMessage For="@(() => bugReport.Severity)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
            @if (isSubmitting)
            {
                <span class="loading-spinner-small"></span>
                <span>Sending...</span>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576 6.636 10.07Zm6.787-8.201L1.591 6.602l4.339 2.76 7.494-7.493Z"/>
                </svg>
                <span>Submit Bug Report</span>
            }
        </button>
    </EditForm>

    @if (submitSuccess)
    {
        <div class="alert alert-success mt-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
            <span>Thank you! Your bug report has been submitted and an email notification has been sent.</span>
        </div>
    }

    @if (submitError)
    {
        <div class="alert alert-danger mt-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <span>Failed to send bug report. Please try again later.</span>
        </div>
    }
</div>

@code {
    private BugReportModel bugReport = new BugReportModel();
    private bool isSubmitting = false;
    private bool submitSuccess = false;
    private bool submitError = false;

    private async Task SubmitBugReport()
    {
        isSubmitting = true;
        submitSuccess = false;
        submitError = false;

        try
        {
            await EmailService.SendBugReportAsync(bugReport);
            submitSuccess = true;
            bugReport = new BugReportModel();
        }
        catch (Exception)
        {
            submitError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class BugReportModel
    {
        [Required(ErrorMessage = "Please enter a title for the bug report.")]
        [StringLength(200, ErrorMessage = "Title cannot exceed 200 characters.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please describe the bug.")]
        [StringLength(2000, ErrorMessage = "Description cannot exceed 2000 characters.")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please select a severity level.")]
        public string Severity { get; set; } = string.Empty;
    }
}
