
@foreach(var task in _models)
{
    <div class="d-flex align-items-center gap-2 rounded border p-2 mb-2">
        <div class="form-check m-0">
            <input class="form-check-input" type="checkbox" checked="@task.IsComplete" @onchange="() => ToggleComplete(task)" />
        </div>
        <div class="flex-grow-1" style="cursor:pointer">
            <div class="fw-semibold @(task.IsComplete ? "text-decoration-line-through text-muted" : "")">@task.Title</div>
            @if (!string.IsNullOrEmpty(task.Description))
            {
                <small class="text-muted">@task.Description</small>
            }
        </div>
        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTask(task)" title="Delete">
            <i class="bi bi-trash"></i>
        </button>
    </div>
}