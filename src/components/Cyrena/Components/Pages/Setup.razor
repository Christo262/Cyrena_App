@page "/app-setup"

<div class="h-100 overflow-auto">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-3">Getting Started</MudText>

    <MudGrid Class="m-0">
        <MudItem md="12" Class="mb-3">
            <MudText Typo="Typo.body1" Align="Align.Center" Class="lead m-0">Choose how you want to connect Cyréna to an AI model.</MudText>
        </MudItem>
    </MudGrid>
    <MudGrid Class="m-0">
        <MudItem md="4" Class="mx-auto">
            <MudPaper Elevation="2" Class="pa-2 text-center">
                <div class="text-center">
                    <MudImage Src="_content/Cyrena/images/ollama-logo.png" Alt="Ollama" Height="300" Class="rounded-lg" />
                </div>
                <MudText Typo="Typo.h5" Class="mt-2">Ollama</MudText>
                <MudText Typo="Typo.body2">Run models locally on your own machine — private, offline, and free.</MudText>
                <MudButton Href="app-setup/ollama" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Setup Ollama</MudButton>
            </MudPaper>
        </MudItem>
        <MudItem md="4" Class="mx-auto">
            <MudPaper Class="pa-2 text-center" Elevation="2">
                <div class="text-center">
                    <MudImage Src="_content/Cyrena/images/openai-logo.png" Alt="OpenAI" Height="300" Class="rounded-lg" />
                </div>
                <MudText Typo="Typo.h5" Class="mt-2">OpenAI</MudText>
                <MudText Typo="Typo.body2">For the latest cloud-powered GPT-family models.</MudText>
                <MudButton Href="app-setup/openai" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Setup OpenAI</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>
