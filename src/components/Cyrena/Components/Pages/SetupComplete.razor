@page "/app-setup/complete"

<div class="h-100 overflow-auto">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-2">You're All Set!</MudText>


    <MudGrid Class="m-0">
        <MudItem md="12" Class="mx-auto">
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-2">
                Cyréna is connected and ready to go. Start chatting or browse extensions to expand what your assistant can do.
            </MudText>

            <div class="text-center">
                <MudButton OnClick="@(() => NavigateCloseTab("app-extensions"))" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Apps" Class="mx-1">Browse Extensions</MudButton>
                <MudButton OnClick="@(() => NavigateCloseTab(""))" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Chat" Class="mx-1">Start Chatting</MudButton>
            </div>
        </MudItem>
    </MudGrid>
</div>
