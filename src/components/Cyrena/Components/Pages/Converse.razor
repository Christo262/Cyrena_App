@page "/converse/{Id}"
@page "/converse"
@using Cyrena.Components.Shared

<MudDynamicTabs @ref="_dynamicTabs" ActivePanelIndex="@_userIndex" ActivePanelIndexChanged="OnTabChange"
                Class="mud-height-full"
                TabPanelsClass="overflow-auto h-100"
                CloseTab="@OnCloseTab"
                ApplyEffectsToContainer
                KeepPanelsAlive>
    <Header>
    </Header>
    <ChildContent>
        @foreach (var item in _active)
        {
            <MudTabPanel ID="@item" Text="@item.GetTitle()" ShowCloseIcon>
                <KernelInstance Kernel="item" />
            </MudTabPanel>
        }
    </ChildContent>
</MudDynamicTabs>
