@inherits KernelComponentBase
@using Microsoft.Extensions.DependencyInjection
@using Cyrena.Extensions
@using Microsoft.SemanticKernel

<div class="p-0 d-flex flex-column h-100 mh-100 rounded">
    <div class="p-3 flex-grow-1 overflow-auto position-relative" style="min-height: 0;" @ref="_scrollHost">
        @if (_msg.DisplayHistory.Count == 0)
        {
            <div class="text-muted">
                <div class="fw-semibold mb-1">Start chatting</div>
                <div>Type a message below. Use Shift+Enter for a new line.</div>
            </div>
        }
        else
        {
            for (int i = 0; i < _msg.DisplayHistory.Count; i++)
            {
                if (_msg.DisplayHistory[i].Role == _msg.Options.LogError)
                {
                    <div class="d-flex mb-3 justify-content-start">
                        <div class="text-danger small" style="white-space: pre-wrap;">@((MarkupString)_msg.DisplayHistory[i].Content)</div>
                    </div>
                }
                else if (_msg.DisplayHistory[i].Role == _msg.Options.LogWarn)
                {
                    <div class="d-flex mb-3 justify-content-start">
                        <div class="text-warning small" style="white-space: pre-wrap;">@((MarkupString)_msg.DisplayHistory[i].Content)</div>
                    </div>
                }
                else if (_msg.DisplayHistory[i].Role == _msg.Options.LogSuccess)
                {
                    <div class="d-flex mb-3 justify-content-start">
                        <div class="text-success small" style="white-space: pre-wrap;">@((MarkupString)_msg.DisplayHistory[i].Content)</div>
                    </div>
                }
                else if (_msg.DisplayHistory[i].Role == _msg.Options.LogInfo)
                {
                    <div class="d-flex mb-3 justify-content-start">
                        <div class="text-muted small" style="white-space: pre-wrap;">@((MarkupString)_msg.DisplayHistory[i].Content)</div>
                    </div>
                }
                else
                {
                    var isUser = _msg.DisplayHistory[i].Role == Microsoft.SemanticKernel.ChatCompletion.AuthorRole.User;
                    <div class="d-flex mb-3 @(isUser ? "justify-content-end" : "justify-content-start")">
                        <div class="chat-bubble @(isUser ? "chat-bubble-user" : "chat-bubble-assistant") px-3 py-2 @(_msg.DisplayHistory[i].Items.Count > 1 ? "chat-bubble-has-items" : "")">
                            @if (_msg.DisplayHistory[i].Items.Count > 1)
                            {
                                <div class="row m-0 mb-1">
                                    @foreach(var item in _msg.DisplayHistory[i].Items.OfType<InfoMessageContentItem>())
                                    {
                                        <div class="col-md-3">
                                            <div class="p-1 d-flex">
                                                <p class="small text-muted m-0 text-truncate">@item.FileName</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (isUser)
                            {
                                <div style="white-space: pre-wrap;">@_msg.DisplayHistory[i].Content</div>
                            }
                            else
                            {
                                <div>@((MarkupString)Markdig.Markdown.ToHtml(_msg.DisplayHistory[i].Content ?? "", _mdp))</div>
                            }
                        </div>
                    </div>
                }
            }



            @if (!string.IsNullOrEmpty(_stream))
            {
                <div class="d-flex mb-3 justify-content-start">
                    <div class="chat-bubble chat-bubble-assistant px-3 py-2">
                        <div>@((MarkupString)Markdig.Markdown.ToHtml(_stream, _mdp))</div>
                    </div>
                </div>
            }
        }

        @if(_its.QueueCount > 0)
        {
            <div class="bg-dark shadow bg-opacity-25 position-fixed p-2" style="z-index:10000;bottom: 105px;right: 10px;">
                @foreach(var input in _its.Queued)
                {
                    <div class="p-1 bg-body shadow rounded border d-flex mb-2" style="width:250px">
                        <p class="small m-0 text-truncate justify-content-center align-self-center">
                            @input.Content
                        </p>
                        <button type="button" @onclick="() => _its.CancelInput(input.Id)" class="btn btn-sm btn-danger rounded-pill ms-auto">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <div class="p-2 pb-0 border-top">
        @if (_items.Any())
        {
            <div class="d-flex flex-row mb-1">
                @foreach(var item in _items)
                {
                    <div class="p-1 d-flex rounded border me-1" style="max-width:200px">
                        <p class="small text-muted m-0 text-truncate justify-content-center align-self-center me-1">@item.Name</p>
                        <button type="button" class="btn btn-sm btn-danger rounded-pill border-0" @onclick="() => RemoveAdditionalItem(item)"><i class="bi bi-x"></i></button>
                    </div>
                }
            </div>
        }

        <div class="p-2 rounded-pill border border-primary">
            <div class="d-flex flex-row">
                <textarea @ref="_area" @bind:event="oninput" placeholder="@(_its.QueueCount > 0 ? "Queue..." : "Reply...")" rows="1" class="form-control auto-grow rounded-pill border-0 me-1" @onkeydown="ComposerKeyDown" @bind="_its.Input"></textarea>

                <div class="ms-2 justify-content-center align-self-center d-flex flex-row">
                    @if(_info.SupportFiles || _info.SupportImages)
                    {
                        <FileUpload OnItemsAdded="OnItemsAdded" Kernel="Kernel"/>
                    }
                    @if (_its.Inferring)
                    {
                        <button type="button" class="btn btn-sm btn-danger rounded-pill ms-1" @onclick="Cancel"><i class="bi bi-stop"></i></button>
                    }
                    <Tooltip Title="@(_its.Inferring ? "Queue" : "Send")">
                        <button type="button" class="btn btn-sm btn-primary rounded-pill ms-1" disabled="@(string.IsNullOrEmpty(_its.Input))" @onclick="Send"><i class="bi bi-arrow-up"></i></button>
                    </Tooltip>

                    <Tooltip Title="@(_its.IsPaused ? "Paused" : "Running")">
                        @if (_its.IsPaused)
                        {
                            <button type="button" class="btn btn-sm btn-danger rounded-pill ms-1" @onclick="()=> _its.ContinueQueue()"><i class="bi bi-play"></i></button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-info rounded-pill ms-1" @onclick="() => _its.PauseQueue()"><i class="bi bi-pause"></i></button>
                        }
                    </Tooltip>
                </div>
            </div>
        </div>

        <ChatToolbar Kernel="Kernel" />
       
    </div>
</div>