@inherits KernelComponentBase
@using Microsoft.Extensions.DependencyInjection
@using Cyrena.Extensions
@using Microsoft.SemanticKernel

<div class="d-flex flex-column h-100" @ref="_dropZone">
    <div class="pa-2 flex-grow-1 overflow-auto relative" style="min-height: 0;" @ref="_scrollHost">
        @if (_pager.History.Count() == 0)
        {
            <MudText Color="Color.Surface">
                <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Start chatting</b></MudText>
                <MudText Typo="Typo.body2">Type a message below. Use Shift+Enter for a new line.</MudText>
            </MudText>
        }
        else
        {
            @if (_pager.CanLoadMore())
            {
                <div class="d-flex mb-3 justify-center">
                    <MudButton OnClick="_pager.IncreasePageCount" Color="Color.Primary" Size="Size.Small">Show More</MudButton>
                </div>
            }
            for (int i = 0; i < _pager.History.Count(); i++)
            {
                var msg = _pager.History.ElementAt(i);
                if (msg.Role == _msg.Options.LogError)
                {
                    <div class="d-flex mb-3 justify-start text-truncate">
                        <MudText Color="Color.Error" Style="white-space: pre-wrap;" Typo="Typo.caption">@((MarkupString)(msg.Content ?? ""))</MudText>
                    </div>
                }
                else if (msg.Role == _msg.Options.LogWarn)
                {
                    <div class="d-flex mb-3 justify-start text-truncate">
                        <MudText Color="Color.Warning" Style="white-space: pre-wrap;" Typo="Typo.caption">@((MarkupString)(_msg.DisplayHistory[i].Content ?? ""))</MudText>
                    </div>
                }
                else if (msg.Role == _msg.Options.LogSuccess)
                {
                    <div class="d-flex mb-3 justify-start text-truncate">
                        <MudText Color="Color.Success" Style="white-space: pre-wrap;" Typo="Typo.caption">@((MarkupString)(msg.Content ?? ""))</MudText>
                    </div>
                }
                else if (msg.Role == _msg.Options.LogInfo)
                {
                    <div class="d-flex mb-3 justify-start text-truncate">
                        <MudText Color="Color.Surface" Style="white-space: pre-wrap;" Typo="Typo.caption">@((MarkupString)(msg.Content ?? ""))</MudText>
                    </div>
                }
                else
                {
#pragma warning disable SKEXP0110
                    var isUser = msg.Role == Microsoft.SemanticKernel.ChatCompletion.AuthorRole.User;
                    var cssmsg = isUser ? "chat-bubble chat-bubble-user px-3 py-2" : "chat-bubble chat-bubble-assistant px-3 py-2";
                    <div class="d-flex mb-3 @(isUser ? "justify-end" : "justify-start")">
                        <MudPaper Class="@cssmsg" Elevation="1">
                            @if (msg.Items.Count > 1)
                            {
                                <div class="d-flex overflow-auto">
                                    @foreach(var item in msg.Items.OfType<FileReferenceContent>())
                                    {
                                        <MudPaper Class="pa-1 me-1" Elevation="0">
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary m-0 text-truncate">@(@item.Metadata?.ContainsKey("name") == true ? item.Metadata["name"] : "unknown")</MudText>
                                        </MudPaper>
                                    }
                                    @foreach (var item in msg.Items.OfType<ImageContent>())
                                    {
                                        <MudPaper Class="pa-1 me-1" Elevation="0">
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary m-0 text-truncate">@(@item.Metadata?.ContainsKey("name") == true ? item.Metadata["name"] : "unknown")</MudText>
                                        </MudPaper>
                                    }
                                </div>
                            }
                            @if (isUser)
                            {
                                <div style="white-space:pre-wrap">
                                    @msg.Content
                                </div>
                            }
                            else
                            {
                                @((MarkupString)Markdig.Markdown.ToHtml(msg.Content ?? "", _mdp))
                            }
                        </MudPaper>
                    </div>
#pragma warning restore SKEXP0110
                }
            }



            @if (!string.IsNullOrEmpty(_stream))
            {
                <div class="d-flex mb-3 justify-start">
                    <MudPaper Class="chat-bubble chat-bubble-assistant px-3 py-2" Elevation="1">
                        @((MarkupString)Markdig.Markdown.ToHtml(_stream, _mdp))
                    </MudPaper>
                </div>
            }
        }

        @if(_its.QueueCount > 0)
        {
            <MudPaper Class="pa-2 fixed" Style="z-index:10000;bottom: 105px;right: 10px;" Elevation="4">
                @foreach(var input in _its.Queued)
                {
                    <MudPaper Class="pa-1 d-flex mb-2" Style="width:250px" Elevation="1">
                        <MudText Typo="Typo.caption" Class="m-0 text-truncate d-flex align-self-center">
                            @input.Message.Content
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Class="ms-auto" OnClick="() => _its.CancelInput(input.Id)" />
                    </MudPaper>
                }
            </MudPaper>
        }
    </div>

    <MudPaper Class="pa-2 pb-0 ml-2" Elevation="0">
        @if (_its.Input != null && _its.Input.Items.Count() > 1)
        {
#pragma warning disable SKEXP0110
            <div class="d-flex flex-row mb-1">
                @foreach (var item in _its.Input.Items.OfType<FileReferenceContent>())
                {
                    <MudPaper Class="pa-1 d-flex me-1" Style="max-width:200px" Elevation="1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary m-0 text-truncate d-flex align-self-center me-1">@(@item.Metadata?.ContainsKey("name") == true ? item.Metadata["name"] : "unknown")</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveAdditionalItem(item)" />
                    </MudPaper>
                }
                @foreach (var item in _its.Input.Items.OfType<ImageContent>())
                {
                    <MudPaper Class="pa-1 d-flex me-1" Style="max-width:200px" Elevation="1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary m-0 text-truncate d-flex align-self-center me-1">@(@item.Metadata?.ContainsKey("name") == true ? item.Metadata["name"] : "unknown")</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveAdditionalItem(item)" />
                    </MudPaper>
                }
            </div>
#pragma warning restore SKEXP0110
        }

        <div class="d-flex flex-row align-center pr-2">
            @if ((_info.SupportFiles || _info.SupportImages) && _ovvr.FileAttacher != null)
            {
@*                 <FileUpload OnItemsAdded="OnItemsAdded" Kernel="Kernel" /> *@
                @this.Render(_ovvr.FileAttacher, new()
                    {
                        {"Kernel", Kernel},
                        {nameof(IFileAttacher.OnItemsAdded), EventCallback.Factory.Create<KernelContent[]>(this, OnItemsAdded)}
                    })
            }
            @if (_its.Input != null)
            {
                <MudTextField T="string" @ref="_area"
                              Variant="Variant.Outlined"
                              Lines="1"
                              Class="mr-2"
                              Immediate
                              MaxLines="6"
                              OnKeyDown="ComposerKeyDown"
                              @bind-Value="_its.Input.Content"
                              Sizing="InputSizing.Auto"
                              Margin="Margin.Dense"
                              Placeholder="@(_its.QueueCount > 0 || _its.Inferring ? "Queue..." : "Reply...")" />
            }

            <MudTooltip Text="@(_its.Inferring ? "Queue" : "Send")">
                <MudFab StartIcon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Primary" Class="mr-1 ml-1" Disabled="@(_its.Input == null || string.IsNullOrEmpty(_its.Input.Content))" OnClick="Send" />
            </MudTooltip>
            @if (_its.Inferring)
            {
                <MudFab StartIcon="@Icons.Material.Filled.Stop" Size="Size.Small" Color="Color.Error" Class="mr-1" OnClick="Cancel" />
            }

            <MudTooltip Text="@(_its.IsPaused ? "Queue Paused" : "Queue Running")">
                @if (_its.IsPaused)
                {
                    <MudFab StartIcon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" Class="mr-1" OnClick="() => _its.ContinueQueue()" />
                }
                else
                {
                    <MudFab StartIcon="@Icons.Material.Filled.Pause" Size="Size.Small" Class="mr-1" OnClick="() => _its.PauseQueue()" />
                }
            </MudTooltip>
        </div>

        <ChatToolbar Kernel="Kernel" />
       
    </MudPaper>
</div>
