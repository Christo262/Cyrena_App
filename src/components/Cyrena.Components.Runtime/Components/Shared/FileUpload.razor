@inherits KernelComponentBase

@if (!string.IsNullOrEmpty(_accepts))
{
    <MudTooltip Text="Attach File">
        <MudFab StartIcon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Class="mr-1" OnClick="TriggerFileUpload" />
    </MudTooltip>

   
    <!-- Hidden File Input -->
    <InputFile @ref="_fileInput"
               OnChange="HandleFilesSelected"
               multiple
               accept="@_accepts"
               style="display: none;" />
}
