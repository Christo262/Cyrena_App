
<div class="mb-3">
    <label class="form-label">Activated Features</label>
<div class="p-2">
        @foreach (var item in _models)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" @bind="item.Selected" @bind:after="PopulateChat" disabled="@item.Required">
                <label class="form-check-label">
                    @item.Plugin.Title
                </label>
            </div>
        }
</div>
</div>