<MudPaper Elevation="0" Class="pa-2">
    <MudText Typo="Typo.subtitle1" Class="mb-2">Activated Features</MudText>
    <MudStack Spacing="1">
        @foreach (var item in _models)
        {
            <MudCheckBox T="bool" Value="item.Selected" ValueChanged="(bool val) => OnSelectionChanged(item, val)" Disabled="item.Required" Dense Size="Size.Small"
                         Label="@item.Plugin.Title" Color="Color.Primary">
            </MudCheckBox>
        }
    </MudStack>
</MudPaper>
