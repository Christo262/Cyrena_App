<MudSelect T="string" Value="Value" ValueChanged="ValueChanged"
           Label="@Label"
           Variant="Variant.Outlined" Dense="true"
           AdornmentIcon="@Icons.Material.Filled.Cable"
           Required="Required"
           Immediate
           Adornment="Adornment.Start">
    <MudSelectItem Value="@((string?)null)">-- Select --</MudSelectItem>
    @foreach (var item in _models)
    {
        <MudSelectItem Value="@item.Id">@item.Name (@item.Source)</MudSelectItem>
    }
</MudSelect>
