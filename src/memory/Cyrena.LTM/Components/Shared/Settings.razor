<MudText Typo="Typo.h5" Class="mb-4">Long-Term Memory</MudText>

<MudForm Model="_model">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="pa-2">
                <MudCheckBox @bind-Value="_model.Enabled" @bind-Value:after="SaveChanges"
                             Label="Memory Context Injection"
                             Color="Color.Primary"
                             Dense="true" />
                <MudText Typo="Typo.caption" Class="mt-1">
                    <span class="mud-error-text">*</span> If Enabled, the application will use your input to preemptively search for relevant long-term memories and inject them into the conversation.
                </MudText>

                <MudSlider T="int" @bind-Value="_model.MaxMemoriesToInject" @bind-Value:after="SaveChanges"
                           Min="2" Max="15"
                           Label="Memory Injection Limit"
                           Color="Color.Primary"
                           Class="mt-4" />
                <MudText Typo="Typo.caption">Memory Injection Limit: @_model.MaxMemoriesToInject</MudText>

                <MudNumericField @bind-Value="_model.MaxAgeDays" @bind-Value:after="SaveChanges"
                                 Label="Maximum Memory Age (Days)"
                                 Min="1"
                                 Variant="Variant.Outlined"
                                 Class="mt-4" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="pa-2">
                <MudSlider T="int" @bind-Value="_relevanceThreshold" @bind-Value:after="SaveRelevance"
                           Min="0" Max="10"
                           Label="Minimum Relevance Threshold"
                           Color="Color.Primary" />
                <MudText Typo="Typo.caption">Minimum Relevance Threshold: @(_relevanceThreshold / 10.0)</MudText>

                <MudCheckBox @bind-Value="_model.IncludeFacts" @bind-Value:after="SaveChanges"
                             Label="Include Facts per Memory"
                             Color="Color.Primary"
                             Dense="true"
                             Class="mt-4" />

                <MudSlider T="int" @bind-Value="_model.MaxFactsPerMemory" @bind-Value:after="SaveChanges"
                           Min="2" Max="15"
                           Label="Maximum Facts per Memory"
                           Color="Color.Primary"
                           Class="mt-4" />
                <MudText Typo="Typo.caption">Maximum Facts per Memory: @_model.MaxFactsPerMemory</MudText>

                <MudButton OnClick="ClearMemory"
                           Color="Color.Error"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Class="mt-4">
                    Erase Long-Term Memory
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudForm>