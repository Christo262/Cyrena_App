@using Cyrena.Extensa.Components.Shared
@inject CyrenaOptions _options
@inherits LayoutComponentBase

<Preload />
<Cyrena.Components.Tools.DisplayServiceComponent />
<Layout ShowCollapseBar ShowFooter="false" SideWidth="0" IsPage IsFullSide="false" IsFixedHeader
        ShowSplitBar SidebarMinWidth="200" SidebarMaxWidth="350" ShowTabInHeader UseTabSet="false"
        TabDefaultUrl="@(_view_start.Href)"
        MenuBarIcon="bi bi-layout-sidebar-inset"
        TabContextMenuCloseIcon="bi bi-x-lg" TabContextMenuCloseAllIcon="bi bi-x-lg" TabContextMenuCloseOtherIcon="bi bi-x-lg" TabStyle="TabStyle.Chrome"
        AdditionalAssemblies="@(_options.GetFeatureAssemblies("blazor").Concat([typeof(MainLayout).Assembly]))">
    <Header>
        <Tooltip Title="Extensions">
            <a href="app-extensions" class="btn btn-outline-light btn-sm rounded-pill mx-1"><i class="bi bi-boxes"></i></a>
        </Tooltip>

        <Tooltip Title="Settings">
            <a href="settings" class="btn btn-outline-light btn-sm rounded-pill"><i class="bi bi-gear"></i></a>
        </Tooltip>
    </Header>
    
    <Main>
        @Body
    </Main>
</Layout>

@if (_loading)
{
    <div class="fixed-top vh-100 vw-100 bg-body bg-opacity-50">
        <div class="d-flex h-100 w-100">
            <div class="spinner-grow m-auto justify-content-center align-self-center" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
}