<MudNavGroup Title="@ChatConfiguration.Title" @bind-Expanded="_open" Class="mb-1">
    <TitleContent>
        <div class="d-flex align-center">
            @if (_is_its)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else if (_is_loaded){
                <MudIcon Icon="@ChatConfiguration[ChatConfiguration.Icon]" Size="Size.Small" Color="Color.Primary"/>
            }
            else
            {
                <MudIcon Icon="@ChatConfiguration[ChatConfiguration.Icon]" Size="Size.Small" />
            }
            <MudText Typo="Typo.subtitle2" Class="ml-2">@ChatConfiguration.Title</MudText>
        </div>
    </TitleContent>
<ChildContent>
        <MudNavLink OnClick="Load">Open</MudNavLink>
        <MudNavLink OnClick="EditAsync">Edit</MudNavLink>
        <MudNavLink OnClick="Delete">Delete</MudNavLink>
</ChildContent>
</MudNavGroup>
