
<NavLink Match="NavLinkMatch.All" href="@($"converse/{ChatConfiguration.Id}")" class="nav-link">
    <div class="submenu-link d-flex">
        <i class="menu-icon @ChatConfiguration[ChatConfiguration.Icon]"></i>
        <span class="menu-text">@(ChatConfiguration.Title ?? "New Chat")</span>

        @if (_is_its)
        {
            <div class="spinner-border spinner-border-sm ms-auto" role="status">
                <span class="visually-hidden">Working...</span>
            </div>
        }
        else if (_is_loaded)
        {
            <i class="bi bi-database-check ms-auto"></i>
        }
    </div>
</NavLink>