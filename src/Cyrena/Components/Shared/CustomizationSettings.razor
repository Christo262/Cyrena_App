<MudText Typo="Typo.h4">Personalization</MudText>

<EditForm Model="_model">
    <DataAnnotationsValidator/>
    <ValidationSummary/>
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudColorPicker Label="Background Color" 
                ColorPickerMode="ColorPickerMode.HEX" 
                ShowAlpha="false"  
                ShowModeSwitch="false"
                Value="@(_model.Background.BackgroundColor ?? "#000000")" 
                PickerVariant="PickerVariant.Dialog"
                ValueChanged="@(v => BackgroundColorChanged(v.Value))" Variant="Variant.Outlined" Class="mb-4" />

            <MudSlider T="int" Value="_bg_opa" Min="0" Max="100" Step="5" ValueChanged="BackgroundOpacityChanged" Color="Color.Primary">
                Background Opacity: @_bg_opa%
            </MudSlider>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.body1">Wallpaper</MudText>
            <MudButton OnClick="TriggerFileUpload" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Image" Class="mr-2">Select</MudButton>
            <MudButton OnClick="NoWallpaper" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.HideImage">No Wallpaper</MudButton>
            <!-- Hidden File Input -->
            <InputFile @ref="_fileInput"
                       OnChange="HandleFilesSelected"
                       accept="image/*"
                       style="display: none;" />
<br />
            <MudButton OnClick="ResetToDefault" Color="Color.Error" Variant="Variant.Filled" Class="mt-4">Reset to Defaults</MudButton>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-4" />

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Starting View" @bind-Value="_model.ViewStart" @bind-Value:after="SaveCustomsSilent" Variant="Variant.Outlined">
                @foreach(var item in _view_starts)
                {
                    <MudSelectItem Value="@item.Href">@item.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</EditForm>
