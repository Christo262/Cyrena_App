@page "/app-setup/openai"
@attribute [TabItemOption(Text = "Setup OpenAI", Icon = "bi bi-magic")]

<div class="h-100 overflow-auto">
    <h1>
        Setup OpenAI
    </h1>
    <hr />

    <div class="row m-0">
        <div class="col-md-9 m-auto bg-body rounded border p-2">
            <h4>
                <span class="badge text-bg-primary rounded-pill">1</span> Get an API Key
            </h4>
            <p>
                Visit <a href="https://platform.openai.com/api-keys" target="_blank">platform.openai.com/api-keys</a>, sign in, and create a new secret key. Keep it safe — you won't be able to view it again after closing the dialog.
            </p>

            <hr />

            <h4>
                <span class="badge text-bg-primary rounded-pill">2</span> Connect Cyréna
            </h4>

            <div class="rounded mt-2 border p-4">
                <EditForm Model="_model" OnValidSubmit="Submit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-2">
                        <label class="form-label">API Key</label>
                        <InputText @bind-Value="_model.ApiKey" type="password" class="form-control" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Model ID</label>
                        <InputText @bind-Value="_model.ModelId" placeholder="e.g. gpt-4o" class="form-control" />
                        <div class="form-text">Find available model IDs at <a href="https://platform.openai.com/docs/models" target="_blank">platform.openai.com/docs/models</a>.</div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Display Name</label>
                        <InputText @bind-Value="_model.DisplayName" placeholder="e.g. My OpenAI Model" class="form-control" />
                    </div>

                    <div class="text-center">
                        <input type="submit" class="btn btn-primary" value="Submit" />
                    </div>
                </EditForm>
            </div>
            <p class="mt-2">
                <span class="text-danger">*</span> Advanced parameters and file or image support can be configured later in Settings (<i class="bi bi-gear"></i>).
            </p>
        </div>
    </div>
</div>