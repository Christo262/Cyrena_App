@page "/app-setup"
@attribute [TabItemOption(Text = "Setup Wizard", Icon = "bi bi-magic")]

<div class="h-100 overflow-auto">
    <h1 class="text-center display-4">
        Getting Started
    </h1>
    <hr />

    <div class="row m-0">
        <div class="col-md-8 m-auto">
            <p class="lead m-0">
                Choose how you want to connect Cyréna to an AI model.
            </p>
        </div>
    </div>
    <div class="row m-0">
        <div class="col-md-2"></div>
        <div class="col-md-4">
            <div class="p-2 text-center rounded border mb-2 bg-body">
                <img src="_content/Cyrena/images/ollama-logo.png" alt="Ollama" class="img-fluid rounded" />
                <p class="lead mt-2">
                    Ollama
                </p>
                <p>
                    Run models locally on your own machine — private, offline, and free.
                </p>
                <a href="app-setup/ollama" class="btn btn-info">Setup Ollama</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-2 text-center rounded border mb-2 bg-body">
                <img src="_content/Cyrena/images/openai-logo.png" alt="OpenAI" class="img-fluid rounded" />
                <p class="lead mt-2">
                    OpenAI
                </p>
                <p>
                    For the latest cloud-powered GPT-family models.
                </p>
                <a href="app-setup/openai" class="btn btn-info">Setup OpenAI</a>
            </div>
        </div>
        <div class="col-md-2"></div>
    </div>
</div>