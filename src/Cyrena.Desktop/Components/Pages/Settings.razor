@page "/settings"
@attribute [TabItemOption(Text = "Settings", Icon = "bi bi-gear")]
@inject ComponentOptions _options


<div class="container">

    <h3>Settings</h3>
    <hr />

    <Tab IsBorderCard Placement="Placement.LeftStart">
        @foreach (var s in _sections)
        {
            <TabItem Text="@s">
                <div class="row m-0">
                    <div class="col-md-8 m-auto">
                        @foreach (var item in _options.GetSettingsComponents().Where(x => x.Section == s).OrderBy(x => x.Order))
                        {
                            <div class="p-2 mb-2">
                                @this.Render(item.Component)
                            </div>
                        }
                    </div>
                </div>
            </TabItem>
        }

        @if (_has_m)
        {
            <TabItem Text="Miscellaneous">
                <div class="row m-0">
                    <div class="col-md-8 m-auto">
                        @foreach (var item in _options.GetSettingsComponents().Where(x => string.IsNullOrEmpty(x.Section)))
                        {
                            <div class="p-2 mb-2">
                                @this.Render(item.Component)
                            </div>
                        }
                    </div>
                </div>
            </TabItem>
        }
    </Tab>

</div>

@code {
    private IEnumerable<string> _sections = default!;
    private bool _has_m{ get; set; }

    protected override void OnInitialized()
    {
        _sections = _options.GetSettingsComponents()
            .Where(x => !string.IsNullOrEmpty(x.Section))
            .OrderBy(x => x.Order)
            .Select(x => x.Section!).Distinct();
        _has_m = _options.GetSettingsComponents().Any(x => string.IsNullOrEmpty(x.Section));
    }
}