@inject CyrenaOptions _options

<Router AppAssembly="typeof(MauiProgram).Assembly"
        AdditionalAssemblies="@(_options.GetFeatureAssemblies("blazor"))">
    <Found Context="routeData">
        <AuthorizedState>
            <RouteView RouteData="routeData" DefaultLayout="typeof(Cyrena.Components.Layout.MainLayout)" />
        </AuthorizedState>
    </Found>
</Router>
