<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Cyrena.Android"
             xmlns:components="clr-namespace:Cyrena.Android.Components"
             xmlns:cyrena="clr-namespace:Cyrena.Components.Shared"
             SafeAreaEdges="Container"
             x:Class="Cyrena.Android.MainPage">

    <local:CustomWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <local:CustomWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            <RootComponent Selector="head-outlet" ComponentType="{x:Type cyrena:HeadOutlet}" />
        </local:CustomWebView.RootComponents>
    </local:CustomWebView>

</ContentPage>
