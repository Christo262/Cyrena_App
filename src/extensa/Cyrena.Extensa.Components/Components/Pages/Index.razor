@page "/app-extensions"

<MudPaper Class="pa-2 h-100" Style="position:relative;overflow:hidden;background-color:transparent">
    <div class="d-flex">
        <h1>
            Extensions
        </h1>

        <div class="ml-auto"></div>
        <div class="justify-center align-self-center">
            <MudTooltip Text="Refresh">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshPackages" Color="Color.Primary" Size="Size.Medium"></MudIconButton>
            </MudTooltip>
        </div>
    </div>
    <MudDrawerContainer Style="height:calc(100% - 48px)">
        <MudDrawer @bind-Open="_draw" Anchor="Anchor.End" Width="70%" Fixed="true" Variant="DrawerVariant.Persistent" Class="mud-height-full">
            @{
                var model = _models.FirstOrDefault(x => x.Id == _in_view);
            }
            @if (model != null)
            {
                <MudPaper Class="pa-2 overflow-auto" Style="height:100%" Outlined="true">
                    <MudStack Spacing="2">

                        <MudStack Row>
                            @if (model.Package?.HasIcon == true)
                            {
                                <img src="@model.Package.IconUrl" alt="@model.Title" class="rounded mr-2" height="40"/>
                            }
                            <MudText Typo="Typo.h6" Inline="true">@model.Title</MudText>
                            <MudSpacer/>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseInView"/>
                        </MudStack>

                        <MudText Typo="Typo.caption"><code>@model.Id</code></MudText>

                        <MudText Typo="Typo.body2" Color="Color.Default">@model.Description</MudText>

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@model.Version</MudChip>
                            @if (model.Extension != null)
                            {
                                if (model.Extension.Status == ExtensionStatus.Unloaded)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">@model.Extension.Status</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@model.Extension.Status</MudChip>
                                }
                            }
                            @if (model.HasUpdate)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Update Available</MudChip>
                            }
                            @if (model.WillUninstall)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Uninstall</MudChip>
                            }
                            @if (model.IsQueued)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Pending</MudChip>
                            }
                            @if (model.Downloading)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Downloading</MudChip>
                            }
                        </MudStack>

                        <MudDivider/>

                        @if (model.Extension?.Errors.Any() == true)
                        {
                            <MudPaper Outlined="true" Class="pa-2" Style="border-color: var(--mud-palette-error);">
                                <MudList T="string" Dense="true">
                                    @foreach (var item in model.Extension.Errors)
                                    {
                                        <MudListItem T="string">
                                            <MudText Color="Color.Error">@item.Message</MudText>
                                        </MudListItem>
                                    }
                                </MudList>
                            </MudPaper>
                        }

                        <MudStack Row="true" Spacing="1">
                            @if (model.Extension != null && model.Extension.Status != ExtensionStatus.Runtime)
                            {
                                if (model.WillUninstall)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info" OnClick="() => CancelUninstall(model.Id)">Cancel Uninstall</MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => MarkUninstall(model.Extension)">Uninstall</MudButton>
                                }

                                if (model.HasUpdate)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="() => QueueDownload(model.Package!)">Update</MudButton>
                                }
                            }

                            @if (model.Extension == null && model.Package != null && !model.Downloading && !model.IsQueued)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="() => QueueDownload(model.Package!)">Download</MudButton>
                            }

                            @if (!string.IsNullOrEmpty(model.Package?.WebPageLink))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info" Href="@model.Package.WebPageLink" Target="_blank">View Online</MudButton>
                            }
                        </MudStack>

                        @if (model.Downloading)
                        {
                            <MudProgressLinear Color="Color.Primary" Striped="true" Rounded="true" Value="@((int)model.DownloadProgress)" Max="100"/>
                        }

                        @if (model.Package != null)
                        {
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                @foreach (var item in model.Package.SupportedOperatingSystems)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@item</MudChip>
                                }
                                @foreach (var item in model.Package.SupportedArchitectures)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@item</MudChip>
                                }
                            </MudStack>
                        }

                        @if (model.Server != null)
                        {
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">Server</MudText>
                                <MudText Typo="Typo.body2">@model.Server.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@model.Server.BaseUrl</MudText>
                            </MudStack>
                        }

                    </MudStack>
                </MudPaper>
            }
        </MudDrawer>
        <div class="h-100 overflow-auto">
            @foreach (var item in _models)
            {
                <MudPaper Class="pa-2 mb-2 clickable" @onclick="() => SetInView(item)">
                    <h5 class="m-0">
                        @if (item.Package?.HasIcon == true)
                        {
                            <img src="@item.Package.IconUrl" alt="@item.Title" class="rounded me-2" height="20"/>
                        }
                        @item.Title
                    </h5>
                    <p class="text-truncate m-0">
                        @item.Description
                    </p>
                    <p class="m-0">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@item.Version</MudChip>
                        @if (item.Extension != null)
                        {
                            if (item.Extension.Status == ExtensionStatus.Unloaded)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">@item.Extension.Status</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@item.Extension.Status</MudChip>
                            }
                        }
                        @if (item.HasUpdate)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Update Available</MudChip>
                        }
                        @if (item.WillUninstall)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Uninstall</MudChip>
                        }
                        @if (item.IsQueued)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Pending</MudChip>
                        }
                        @if (item.Downloading)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Downloading</MudChip>
                        }
                    </p>
                </MudPaper>
            }
        </div>
    </MudDrawerContainer>
</MudPaper>