<div class="d-flex mb-2">
    <MudText Typo="Typo.h4">Extension Servers</MudText>
    <div class="ms-auto"></div>

    @if (_ui.FileSystemOptions.ExploreFolder)
    {
        <MudButton OnClick="OpenExtensions" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="me-1">Extensions Folder</MudButton>
        <MudButton OnClick="OpenInstallations" Variant="Variant.Filled" Color="Color.Info" Size="Size.Small">Installations Folder</MudButton>
    }
</div>
<MudAlert Severity="Severity.Success">
    <span class="text-danger">*</span> Extension servers provide additional extensions and updates to Cyréna. Add custom servers to host your own. Visit <a href="https://cyrena.dev" target="_blank">cyrena.dev</a> to learn more.
</MudAlert>

<MudTable Items="_models" Dense="true" Hover="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>BaseUrl</MudTh>
        <MudTh>Enabled</MudTh>
        <MudTh>
            <MudTooltip Text="Add Server">
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="Add" />
            </MudTooltip>
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.BaseUrl</MudTd>
        <MudTd>
            <MudSwitch T="bool" Value="@context.IsEnabled" Disabled="@context.IsDefault" ValueChanged="(e) => OnServerEnableChange(context, e)" />
        </MudTd>
        <MudTd>
            @if (!context.IsDefault)
            {
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Edit(context)" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="() => Delete(context)" />
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
</MudTable>
