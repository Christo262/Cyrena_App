@inherits KernelComponentBase

<MudTooltip Text="API References">
    <MudIconButton Color="Color.Inherit" Size="Size.Small" Href="@($"api-references/{_kernelId}")" Icon="@Icons.Material.Filled.Api">
    </MudIconButton>
</MudTooltip>

@code {
    private string _kernelId { get; set; } = default!;

    protected override void OnInitialized()
    {
        var cfg = Kernel.Services.GetRequiredService<IChatConfigurationService>();
        _kernelId = cfg.Config.Id;
    }
}
