@page "/api-reference-edit/{RefId}/{KernelId}"
@page "/api-reference-create/{KernelId}"
@using Cyrena.Components.Shared

@if (_model != null)
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync" Class="h-100">
        <DataAnnotationsValidator />
        <MudGrid Class="m-0 h-100">
            <MudItem xs="12">
                <MudPaper Class="d-flex flex-row p-2" Elevation="0">
                    <MudTooltip Text="Back">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" Size="Size.Small" OnClick="Cancel" Class="mr-1">
                        </MudIconButton>
                    </MudTooltip>
                    <MudText Typo="Typo.h6" Class="ml-3 mt-1">Edit API References</MudText>
                    <MudSpacer />
                </MudPaper>
                <MudDivider />
                <ValidationSummary />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.Title" Label="Title" Variant="Variant.Outlined" Class="mb-3" />

                <MudTextField @bind-Value="_model.Summary" Label="Summary" Variant="Variant.Outlined" Lines="5" Class="mb-3" />

                <MudTextField @bind-Value="_keywords" Label="Keywords" Variant="Variant.Outlined" Lines="5" Class="mb-3" />
                <MudText Typo="Typo.caption" Class="text-muted">
                    <span class="text-danger">*</span> Enter keywords comma separated
                </MudText>

                <MudTextField @bind-Value="_model.Link" Label="Link" Variant="Variant.Outlined" Class="mb-3" />
            </MudItem>
            <MudItem xs="12" md="8">
                <CodeInput @bind-Value="_model.Content" Language="markdown"/>
            </MudItem>

            <MudItem xs="12" Class="mt-2">
                <ValidationSummary />
                <MudStack Justify="Justify.Center" Row="true">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" ButtonType="ButtonType.Submit">Save</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Cancel">Cancel</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </EditForm>
}
