@page "/api-references/{KernelId}"

<MudGrid Class="m-0">
    <MudItem xs="12">
        <MudPaper Class="d-flex flex-row p-2" Elevation="0">
            <MudTooltip Text="Back">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="Back" Class="me-1">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />
                </MudButton>
            </MudTooltip>
            <MudText Typo="Typo.h6" Class="ms-3 mt-1">API References</MudText>
            <MudSpacer />
            <MudTooltip Text="Import">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Import" Class="me-1">
                    <MudIcon Icon="@Icons.Material.Filled.Download" />
                </MudButton>
            </MudTooltip>
            <MudTooltip Text="Create">
                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" Href="@($"api-reference-create/{KernelId}")" Class="me-1">
                    <MudIcon Icon="@Icons.Material.Filled.Add" />
                </MudButton>
            </MudTooltip>
        </MudPaper>
    </MudItem>
</MudGrid>
<MudContainer Class="overflow-auto">
    @foreach (var item in _models)
    {
        <MudPaper Class="my-2 p-2" Elevation="1">
            <MudGrid Class="m-0">
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body1" Class="m-0">@item.Title</MudText>
                    <MudText Typo="Typo.caption" Class="m-0 text-muted">
                        @item.Summary
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudText Typo="Typo.caption" Class="m-0 text-truncate">
                        @string.Join(", ", item.Keywords)
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudTooltip Text="Edit">
                        <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" Href="@($"api-reference-edit/{item.Id}/{KernelId}")" Class="me-1">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" />
                        </MudButton>
                    </MudTooltip>
                    <MudTooltip Text="Export">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="() => Export(item)" Class="me-1">
                            <MudIcon Icon="@Icons.Material.Filled.Upload" />
                        </MudButton>
                    </MudTooltip>
                    <MudTooltip Text="Delete">
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="() => Delete(item)">
                            <MudIcon Icon="@Icons.Material.Filled.Delete" />
                        </MudButton>
                    </MudTooltip>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</MudContainer>
