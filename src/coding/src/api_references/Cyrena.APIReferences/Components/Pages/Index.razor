@page "/api-references/{KernelId}"

<div class="h-100">
    <MudPaper Class="d-flex flex-row pa-2 mb-2" Elevation="0">
        <MudTooltip Text="Back">
            <MudIconButton Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.ArrowBack" OnClick="Back" Class="mr-1">
            </MudIconButton>
        </MudTooltip>
        <MudText Typo="Typo.h6" Class="ms-3 mt-1">API References</MudText>
        <MudSpacer />
        <MudTooltip Text="Import">
            <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" OnClick="Import" Class="mr-1">
            </MudIconButton>
        </MudTooltip>
        <MudTooltip Text="Create">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Href="@($"api-reference-create/{KernelId}")" Class="mr-3">
            </MudIconButton>
        </MudTooltip>
    </MudPaper>
    <MudContainer Class="overflow-auto" Style="height:calc(100% - 60px)">
        @foreach (var item in _models)
        {
            <MudPaper Class="mb-2 pa-2" Elevation="1">
                <MudGrid Class="m-0">
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.body1" Class="m-0">@item.Title</MudText>
                        <MudText Typo="Typo.caption" Class="m-0 text-muted">
                            @item.Summary
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudText Typo="Typo.caption" Class="m-0 text-truncate">
                            @string.Join(", ", item.Keywords)
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex align-center">
                        <MudTooltip Text="Edit">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"api-reference-edit/{item.Id}/{KernelId}")" Class="mr-1">
                            </MudIconButton>
                        </MudTooltip>
                        <MudTooltip Text="Export">
                            <MudIconButton Icon="@Icons.Material.Filled.Upload" Size="Size.Small" OnClick="() => Export(item)" Class="mr-1">
                            </MudIconButton>
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => Delete(item)">
                            </MudIconButton>
                        </MudTooltip>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </MudContainer>
</div>
