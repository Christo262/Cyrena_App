@using Cyrena.Components.Shared

<MudDialog>
    <DialogContent>
        <MudGrid>
            @foreach (var env in Controller.Environments)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard @onclick="() => SetEnvironment(env)" Class="cursor-pointer">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">@env</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Done</MudButton>
    </DialogActions>
</MudDialog>