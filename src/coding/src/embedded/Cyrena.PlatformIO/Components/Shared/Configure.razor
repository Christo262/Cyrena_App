@using Cyrena.Components.Shared

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Title" Label="Title" Required="true" />
            <MudTextField @bind-Value="_model.IniPath" Label="platformio.ini" Required="true"
                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="PickProject" />
            <ConnectionSelector @bind-Value="_model.ConnectionId" />
            <EnvironmentSelector @bind-Value="_model.Environment" />
            <PluginSelector Chat="Model" />
            <HistoryConfiguration Model="Model" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">Submit</MudButton>
    </DialogActions>
</MudDialog>