<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cyrena.Components.Core" />
        <PackageReference Include="Cyrena.Extensa.Core" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cyrena.Dotnet.Core\Cyrena.Dotnet.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="extension.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\cs-prompt.md" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Components\Shared\Configure.razor" />
      <AdditionalFiles Include="Components\_Imports.razor" />
    </ItemGroup>

</Project>
