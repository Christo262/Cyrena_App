@using Cyrena.Components.Shared

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Title" Label="Title" Required="true" Class="mb-2" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <ConnectionSelector @bind-Value="_model.ConnectionId" />
            <MudTextField @bind-Value="_model.ProjectFilePath" Label="Project File" Required="true" 
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FileOpen" Variant="Variant.Outlined" Margin="Margin.Dense"
                          OnAdornmentClick="ChooseProj" Class="mb-2" />
            <PluginSelector Chat="Model"/>
            <HistoryConfiguration Model="Model" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">Submit</MudButton>
    </DialogActions>
</MudDialog>