@inherits KernelComponentBase

<MudContainer Class="overflow-auto" Style="max-height:50vh">
    @foreach (var item in _sln.GetAllProjects())
    {
        <MudPaper Class="mb-2 pa-2 rounded border d-flex" Elevation="0">
            <div>
                <MudText Typo="Typo.body1" Class="m-0 text-truncate">@item.ProjectName</MudText>
                <MudSelect T="string" @bind-Value="item.ProjectTypeId" @bind-Value:after="() => Override(item)" 
                           Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("")">Hidden</MudSelectItem>
                    @foreach(var proj in _projects)
                    {
                        <MudSelectItem Value="@proj.Id">@proj.ProjectTypeName</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="ml-auto d-flex align-center">
                @if (!string.IsNullOrEmpty(item.ProjectTypeId) && _sln.Current.Id != item.Id)
                {
                    <MudTooltip Text="Set Active">
                        <MudIconButton Color="Color.Primary" Variant="Variant.Filled" 
                                   OnClick="() => SetActive(item)"
                                   Icon="@Icons.Material.Filled.CheckBox" />
                    </MudTooltip>
                }
            </div>
        </MudPaper>
    }
</MudContainer>