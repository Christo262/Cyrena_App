@using Cyrena.Components.Shared

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Title" Label="Title" Required="true" />
            <ConnectionSelector @bind-Value="_model.ConnectionId"/>
            <MudTextField @bind-Value="_model.SolutionFilePath" Label="Solution File" Required="true" 
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FileOpen" 
                          OnAdornmentClick="ChooseSln" />
            <PluginSelector Chat="Configuration"/>
            <HistoryConfiguration Model="Configuration" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">Submit</MudButton>
    </DialogActions>
</MudDialog>