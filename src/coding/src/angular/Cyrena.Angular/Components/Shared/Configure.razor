@using Cyrena.Components.Shared

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudTextField @bind-Value="_model.Title" Label="Title" Required="true" />
            <MudTextField @bind-Value="_model.ProjectPath" Label="Project Path" Required="true"
                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="PickFile" />
            <ConnectionSelector @bind-Value="_model.ConnectionId" />
            <PluginSelector Chat="Model" />
            <HistoryConfiguration Model="Model"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ChatConfiguration Model { get; set; } = default!;
    [Inject] private IFileDialog _win { get; set; } = default!;
    [Inject] private ISnackbar _snackbar { get; set; } = default!;
    private AngularConfig _model { get; set; } = default!;
    private MudForm _form = default!;

    protected override void OnInitialized()
    {
        _model = new AngularConfig()
        {
            ProjectPath = Model[AngularOptions.AngularJson],
            Title = Model.Title,
            ConnectionId = Model.ConnectionId
        };
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        Model.Title = _model.Title;
        Model.ConnectionId = _model.ConnectionId!;
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task PickFile()
    {
        try
        {
            var files = await _win.OpenAsync("Choose angular.json", ("json", [".json"]));
            if (!string.IsNullOrEmpty(files))
            {
                var info = new FileInfo(files);
                Model[AngularOptions.AngularJson] = files;
                _model.ProjectPath = files;
                Model.WorkingDirectory = info.DirectoryName;
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add(ex.Message, Severity.Error);
        }
    }

    internal class AngularConfig
    {
        [Required]
        public string? Title { get; set; }
        [Required]
        public string? ProjectPath { get; set; }
        [Required]
        public string? ConnectionId { get; set; }
    }
}