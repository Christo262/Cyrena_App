@page "/develop-file-viewer/{FileId}/{KernelId}"
@attribute [TabItemOption(Text = "File Versions", Icon = "bi bi-git")]

@using BlazorMonaco
@using BlazorMonaco.Editor
@using BlazorMonaco.Languages


@if (_kernel != null)
{
    <div class="mb-2 d-flex flex-row align-items-center px-2">
        <Tooltip Title="Back">
            <a class="btn btn-sm btn-outline-primary me-1" href="converse/@KernelId"><i class="bi bi-arrow-left"></i></a>
        </Tooltip>

        @if (_originals != null && _originals.Count > 0)
        {
            <select class="form-control form-control-sm" style="max-width:320px" @bind="_selectedVersionIndex" @bind:after="OnVersionSelected">
                <option value="">--Select--</option>
                @for (int i = _originals.Count - 1; i >= 0; i--)
                {
                    var version = _originals[i];
                    var index = i;
                    var label = string.IsNullOrEmpty(version.Label) ? $"Version {index + 1}" : version.Label;
                    var display = $"{version.Timestamp:MMM d, HH:mm:ss}  —  {label}";
                    <option value="@index">@display</option>
                }
            </select>
        }

        <div class="ms-auto"></div>

        @if (_og_target != null)
        {
            <Tooltip Title="Revert to selected version">
                <button type="button" @onclick="Revert" class="btn btn-sm btn-info me-1"><i class="bi bi-arrow-counterclockwise"></i></button>
            </Tooltip>

            <Tooltip Title="Keep current">
                <button type="button" @onclick="Keep" class="btn btn-sm btn-success"><i class="bi bi-check2-circle"></i></button>
            </Tooltip>
        }
    </div>

    <StandaloneDiffEditor @ref="_diffEditor" Id="@FileId" ConstructionOptions="DiffEditorConstructionOptions"
                          OnDidInit="EditorOnDidInit" />
}
