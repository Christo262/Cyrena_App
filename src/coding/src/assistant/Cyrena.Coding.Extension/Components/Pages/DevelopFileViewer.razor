@page "/develop-file-viewer/{FileId}/{KernelId}"
@using BlazorMonaco
@using BlazorMonaco.Editor
@using BlazorMonaco.Languages

@if (_kernel != null)
{
    <div class="mb-2 d-flex flex-row align-items-center px-2">
        <MudTooltip Text="Back">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => _nav.NavigateTo($"converse/{KernelId}"))" Size="Size.Small" Color="Color.Primary" Class="me-1" />
        </MudTooltip>

        @if (_originals != null && _originals.Count > 0)
        {
            <MudSelect T="int" @bind-Value="_selectedVersionIndex" @bind-Value:after="OnVersionSelected" Style="max-width:320px" Dense="true" Variant="Variant.Outlined">
                @for (int i = _originals.Count - 1; i >= 0; i--)
                {
                    var version = _originals[i];
                    var index = i;
                    var label = string.IsNullOrEmpty(version.Label) ? $"Version {index + 1}" : version.Label;
                    var display = $"{version.Timestamp:MMM d, HH:mm:ss} - {label}";
                    <MudSelectItem Value="@index">@display</MudSelectItem>
                }
            </MudSelect>
        }

        <div class="ms-auto"></div>

        @if (_og_target != null)
        {
            <MudTooltip Text="Revert to selected version">
                <MudIconButton Icon="@Icons.Material.Filled.Restore" OnClick="Revert" Size="Size.Small" Color="Color.Info" Class="me-1" />
            </MudTooltip>

            <MudTooltip Text="Keep current">
                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" OnClick="Keep" Size="Size.Small" Color="Color.Success" />
            </MudTooltip>
        }
    </div>
    <StandaloneDiffEditor @ref="_diffEditor" Id="@FileId" ConstructionOptions="DiffEditorConstructionOptions" OnDidInit="EditorOnDidInit"></StandaloneDiffEditor>
}
