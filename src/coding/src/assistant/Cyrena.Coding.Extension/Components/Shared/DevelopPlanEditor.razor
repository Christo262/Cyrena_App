@inherits KernelComponentBase

<div class="h-100 d-flex flex-column pa-4">
    <div class="flex-1 overflow-auto">
        @if (_currentPlan is not null)
        {
            @foreach (var item in _currentPlan.Folders)
            {
                <PlanFolderNode Folder="item" OnDelete="DeleteFolder"></PlanFolderNode>
            }
            <MudButton StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="AddFolder">Add Folder</MudButton>
            <br/>
            
            <div class="rounded-lg border border-solid pa-2 mb-2">
                <MudText Typo="Typo.caption">read/write file types</MudText><br/>
                @foreach (var item in _currentPlan.AllowedFileTypes)
                {
                    <MudChip T="string" Value="item" OnClose="chip => RemoveFileType(chip.Value)">@item</MudChip>
                }
                <MudChip T="string" Value="string.Empty" OnClick="AddFileType">Add File Type</MudChip>
            </div>
            
            <div class="rounded-lg border border-solid pa-2">
                <MudText Typo="Typo.caption">read only file types</MudText><br/>
                @foreach (var item in _currentPlan.ReadOnlyFileTypes)
                {
                    <MudChip T="string" Value="item" OnClose="chip => RemoveReadFileType(chip.Value)">@item</MudChip>
                }
                <MudChip T="string" Value="string.Empty" OnClick="AddReadFileType">Add File Type</MudChip>
            </div>
        }
    </div>
    <MudStack Row="true" AlignItems="AlignItems.End" Justify="Justify.FlexEnd">
        <MudButton Color="Color.Primary" OnClick="SaveAsync" Variant="Variant.Filled">Save</MudButton>
    </MudStack>
</div>