<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Value"></MudTextField>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] private IMudDialogInstance _mudDialog { get; set; } = null!;
    [Parameter] public string? Value { get; set; }

    private void Cancel() => _mudDialog.Cancel();

    private void Submit()
    {
        _mudDialog.Close(DialogResult.Ok(Value));
    }
}