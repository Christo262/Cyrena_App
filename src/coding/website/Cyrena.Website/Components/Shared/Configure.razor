@inject IFileDialog _files
@using Cyrena.Components.Shared

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="Model">

            <MudTextField @bind-Value="Model.Title" Label="Title" Required="true" />
            <MudTextField @bind-Value="Model.WorkingDirectory" Label="Working Directory" Required="true"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="ChooseFolder"
                          HelperText="The folder where your website files will be created" />
            @if (!string.IsNullOrEmpty(_error))
            {
                <span class="text-danger">@_error</span>
            }

            <ConnectionSelector @bind-Value="Model.ConnectionId" />

            <PluginSelector Chat="Model" />
            <HistoryConfiguration Model="Model" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public ChatConfiguration Model { get; set; } = default!;
    private MudForm _form = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string? _error{ get; set; }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        if (string.IsNullOrEmpty(Model.WorkingDirectory) || !Directory.Exists(Model.WorkingDirectory))
        {
            _error = "Please select a valid working directory";
            this.StateHasChanged();
            return;
        }
        MudDialog.Close(DialogResult.Ok(Model));
    }

    public async Task ChooseFolder()
    {
        var folder = await _files.SelectFolder("Select Working Directory", Model.WorkingDirectory);
        Model.WorkingDirectory = folder;
    }

    private void Cancel() => MudDialog.Cancel();
}
