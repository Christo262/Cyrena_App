@implements IResultDialog
@inject IFileDialog _files
@using Cyrena.Coding.Options
@using Cyrena.Options
@using Cyrena.Website.Models
@using Cyrena.Website.Options
@using Cyrena.Components.Shared
@using Newtonsoft.Json

<EditForm EditContext="_context">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="mb-3">
        <label class="form-label">Project Name</label>
        <InputText @bind-Value="Model.Title" class="form-control" placeholder="My Awesome Site" />
    </div>

    <div class="mb-3">
        <label class="form-label">Working Directory</label>
        <div class="input-group">
            <InputText @bind-Value="Model.WorkingDirectory" class="form-control" />
            <button class="btn btn-secondary" type="button" @onclick="ChooseFolder"><i class="bi bi-file"></i></button>
        </div>
        <p class="m-0 small">
            <span class="text-danger">*</span> The folder where your website files will be created
        </p>
        @if (!string.IsNullOrEmpty(_error))
        {
            <span class="text-danger">@_error</span>
        }
    </div>

    <ConnectionSelector @bind-Value="Model.ConnectionId" />

    <PluginSelector Chat="Model" />
</EditForm>

@code {
    [Parameter]
    public ChatConfiguration Model { get; set; } = default!;

    private EditContext _context = default!;
    private string? _error{ get; set; }

    protected override void OnInitialized()
    {
        _context = new EditContext(Model);
    }

    public async Task<bool> OnClosing(DialogResult result)
    {
        if (result != DialogResult.Yes) return true;
        var valid = _context.Validate();
        if (string.IsNullOrEmpty(Model.WorkingDirectory) || !Directory.Exists(Model.WorkingDirectory))
        {
            _error = "Please select a valid working directory";
            this.StateHasChanged();
            return false;
        }
        return valid;
    }

    public async Task ChooseFolder()
    {
        var folder = await _files.SelectFolder("Select Working Directory", Model.WorkingDirectory);
        Model.WorkingDirectory = folder;
    }

    public Task OnClose(DialogResult result)
    {
        return Task.CompletedTask;
    }
}
