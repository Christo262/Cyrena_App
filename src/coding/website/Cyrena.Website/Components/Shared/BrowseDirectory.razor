@using Cyrena.Coding.Options
@inherits KernelComponentBase
@inject IFileDialog _files

<button class="btn btn-secondary btn-sm rounded-pill me-1" @onclick="OnClick" type="button">
    <i class="bi bi-folder-symlink"></i>
</button>

@code {
    private void OnClick()
    {
        var config = Kernel.GetRequiredService<IChatConfigurationService>();
        _files.ExploreFolder(config.Config.WorkingDirectory!);
    }
}