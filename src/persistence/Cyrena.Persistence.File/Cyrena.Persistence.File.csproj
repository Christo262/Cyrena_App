<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.6.0</Version>
    <Title>Cyréna Persistence Implementation</Title>
    <Authors>Vaya Nova</Authors>
    <Description>Use existing persistence framework within Cyréna for custom long-term storage.</Description>
    <RepositoryUrl>https://github.com/Christo262/Cyrena_App</RepositoryUrl>
    <PackageProjectUrl>https://cyrena.dev</PackageProjectUrl>
    <PackageIcon>cyrena.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\cyrena.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cyrena.Persistence.Core\Cyrena.Persistence.Core.csproj" />
  </ItemGroup>

  <Target Name="PostPack" AfterTargets="Pack">
    <ItemGroup>
      <NugetPackages Include="bin\Debug\$(PackageId).$(PackageVersion).nupkg" />
    </ItemGroup>

    <Copy SourceFiles="@(NugetPackages)" DestinationFolder="../../../sdk" SkipUnchangedFiles="true" />
  </Target>

</Project>
