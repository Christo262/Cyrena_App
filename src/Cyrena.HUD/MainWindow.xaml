<Window x:Class="Cyrena.HUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:Cyrena.HUD"
        xmlns:components="clr-namespace:Cyrena.HUD.Components"
        xmlns:cyrena="clr-namespace:Cyrena.Components.Shared;assembly=Cyrena"
        mc:Ignorable="d"
        Title="MainWindow" d:Height="600" d:Width="1000"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <local:CustomBlazorWebView Grid.Row="0" x:Name="mainView" HostPage="wwwroot/dark.html" Services="{DynamicResource services}">
            <local:CustomBlazorWebView.RootComponents>
                <blazor:RootComponent Selector="head-outlet" ComponentType="{x:Type cyrena:HeadOutlet}" />
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </local:CustomBlazorWebView.RootComponents>
        </local:CustomBlazorWebView>
    </Grid>
</Window>
