@page "/"
@attribute [TabItemOption(Text = "New Chat", Icon = "bi bi-chat-dots")]

<div class="h-100 overflow-auto d-flex">

    <div class="col-8 bg-body p-2 rounded justify-content-center align-self-center m-auto">
        <div class="text-center">
            <img src="images/rene_f.png" height="200" class="rounded-pill mb-2" />
        </div>

        @if (_model != null)
        {
            <div class="d-flex flex-row p-2 rounded-pill border border-primary">
                <textarea @bind="_input" class="form-control rounded-pill border-0 me-1"
                          @ref="_area"
                          rows="1"
                          placeholder="How can I help you?"
                          @oninput="AutoGrow" @onkeydown="ComposerKeyDown"></textarea>

                <div class="me-1 justify-content-center align-self-center">
                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill" @onclick="Settings"><i class="bi bi-gear"></i></button>
                </div>
                <div class="justify-content-center align-self-center">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill" @onclick="Send"><i class="bi bi-arrow-up"></i></button>
                </div>
            </div>

            <div class="my-2">
                <Shortcuts></Shortcuts>
            </div>
        }
        else
        {
            <div class="text-center py-2">
                <p>
                    <span class="text-danger">*</span> Go to <a href="settings">Settings</a> to configure AI connections and get started.
                </p>
            </div>
        }
    </div>

</div>

@if (_model != null)
{
    <Modal @ref="_config" IsKeyboard>
        <ModalDialog Title="Configure Chat" ShowSaveButton="false" ShowCloseButton Size="Size.Medium">
            <BodyTemplate>
                <EditForm Model="_model">
                    <ConnectionSelector @bind-Value="_model.ConnectionId" />
                    <PluginSelector Chat="_model" />
                </EditForm>
            </BodyTemplate>
        </ModalDialog>
    </Modal>
}
