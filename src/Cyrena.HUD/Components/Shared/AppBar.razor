@inject MainWindow _main
@inject NavigationManager _nav

<div class="container ps-1 bg-body rounded border shadow pe-0">
    <div class="d-flex">
        <div class="p-1">
            <img src="images/rene.png" alt="Rene" class="rounded" style="height:35px"/>
        </div>
        <p class="m-0 lead py-2">
            Cyréna
        </p>
        <div class="ms-auto"></div>

        <Tooltip Title="Extensions">
            <button type="button" @onclick="@(() => _nav.NavigateTo("app-extensions"))" class="btn btn-outline-light rounded-0 border-0 h-100"><i class="bi bi-boxes"></i></button>
        </Tooltip>
        <Tooltip Title="Settings">
            <button type="button" class="btn btn-outline-light rounded-0 border-0 h-100" @onclick="@(() => _nav.NavigateTo("settings"))"><i class="bi bi-gear"></i></button>
        </Tooltip>
        <Tooltip Title="Minimize">
            <button class="btn btn-outline-light rounded-0 border-0 h-100" type="button" @onclick="() => _main.Minimize()"><i class="bi bi-fullscreen-exit"></i></button>
        </Tooltip>
        <button class="btn btn-danger rounded-0 rounded-end" type="button" @onclick="() => _main.Close()"><i class="bi bi-x-lg"></i></button>
    </div>
</div>