@using Cyrena.Extensa.Components.Shared
@inject CyrenaOptions _options
@inherits LayoutComponentBase

<Preload/>
<AppBar />

<div class="mt-5 flex-fill overflow-auto">
    <div class="row m-0 h-100" style="max-height:100%">
        <div class="h-100 col-2 overflow-auto">
            <div class="p-2 rounded bg-body shadow border">
                <p>Chats</p>
                <hr />

                <NavLink Match="NavLinkMatch.All" class="btn btn-outline-light w-100 text-start border-0" href=""><i class="bi bi-plus"></i> New Chat</NavLink>

                @if(_chats is not null)
                {
                    foreach (var item in _chats.Where(x => x[ChatConfiguration.Group] is null))
                    {                    
                        <ContextMenuZone>
                            <ContextMenuTrigger>
                                <KernelWatcherNavLink ChatConfiguration="item"/>
                            </ContextMenuTrigger>
                            <ContextMenu>
                                @if (_controller.KernelActive(item.Id))
                                {
                                    <ContextMenuItem Icon="bi bi-database-down" Text="Unload" OnClick="(s, e) => Unload(item)"></ContextMenuItem>
                                }
                                <ContextMenuItem Icon="bi bi-pen" Text="Edit" OnClick="(s, e) => EditAsync(item)"></ContextMenuItem>
                                <ContextMenuItem Icon="bi bi-trash" Text="Delete" OnClick="(s, e) => Delete(item)"></ContextMenuItem>
                            </ContextMenu>
                        </ContextMenuZone>
                    }
                }
            </div>

            @if(_groups is not null)
            {
                @foreach (var g in _groups.Where(x => !string.IsNullOrEmpty(x)))
                {
                    <div class="p-2 rounded bg-body shadow border mt-2">
                        <p>@g</p>
                        <hr />
                        @if (_chats is not null)
                        {
                            foreach (var item in _chats.Where(x => x[ChatConfiguration.Group] == g))
                            {
                                <ContextMenuZone>
                                    <ContextMenuTrigger>
                                        <KernelWatcherNavLink ChatConfiguration="item"/>
                                    </ContextMenuTrigger>
                                    <ContextMenu>
                                        @if (_controller.KernelActive(item.Id))
                                        {
                                            <ContextMenuItem Icon="bi bi-database-down" Text="Unload" OnClick="(s, e) => Unload(item)"></ContextMenuItem>
                                        }
                                        <ContextMenuItem Icon="bi bi-pen" Text="Edit" OnClick="(s, e) => EditAsync(item)"></ContextMenuItem>
                                        <ContextMenuItem Icon="bi bi-trash" Text="Delete" OnClick="(s, e) => Delete(item)"></ContextMenuItem>
                                    </ContextMenu>
                                </ContextMenuZone>
                            }
                        }
                    </div>
                }
            }
        </div>


        <div class="col-8 overflow-auto bg-body rounded border h-100 p-0">
            <Layout ShowFooter="false" 
                    UseTabSet TabDefaultUrl="/"
                    TabContextMenuCloseIcon="bi bi-x-lg" TabContextMenuCloseAllIcon="bi bi-x-lg" TabContextMenuCloseOtherIcon="bi bi-x-lg" TabStyle="TabStyle.Chrome"
                AdditionalAssemblies="@(_options.GetFeatureAssemblies("blazor").Concat([typeof(MainLayout).Assembly]))">
                <Main>
                    @Body
                </Main>
            </Layout>
        </div>
    </div>
</div>