<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="Model">
            <MudTextField @bind-Value="Model.ModelId" Label="Model ID" Required="true" />
            <MudTextField @bind-Value="Model.DisplayName" Label="Display Name" Required />

            <MudSlider @bind-Value="Model.MTemperature" Min="0" Max="20" Step="1" TickMarks="true">
                Temperature: @Model.Temperature
            </MudSlider>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                The temperature of the model. Increasing the temperature will make the model answer more creatively. (Default: 1.0)
            </MudText>

            <MudSlider @bind-Value="Model.MTopP" Min="5" Max="100" Step="5" TickMarks="true">
                TopP: @Model.TopP
            </MudSlider>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                A higher value (e.g., 0.95) will lead to more diverse text, while a lower value (e.g., 0.5) will generate more focused and conservative text. (Default: 1.0)
            </MudText>

            <MudCheckBox @bind-Value="Model.SupportImages" Label="Support Images" />
            <MudCheckBox @bind-Value="Model.SupportFiles" Label="Support Files" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error">Cancel</MudButton>
        <MudButton OnClick="Submit">Submit</MudButton>
    </DialogActions>
</MudDialog>