<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.h4">OpenAI Settings</MudText>
    <MudSpacer/>

    <MudTooltip Text="Add Model">
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Small" OnClick="Add" />
    </MudTooltip>
</MudStack>

@if (_model != null)
{
<MudGrid>
    <MudItem md="6" Class="mx-auto">
            <MudForm Model="_model">
                <MudTextField @bind-Value="_model.ApiKey" Label="API Key" InputType="InputType.Password" Class="mb-2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Save">
                    Save API Key
                </MudButton>
            </MudForm>

            <MudText Typo="Typo.h5" Class="mt-4">Models</MudText>
            <MudTable Items="_models" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Model Id</MudTh>
                    <MudTh>Display Name</MudTh>
                    <MudTh>Temperature</MudTh>
                    <MudTh>
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Model Id">@context.ModelId</MudTd>
                    <MudTd DataLabel="Display Name">@context.DisplayName</MudTd>
                    <MudTd DataLabel="Temperature">@context.Temperature</MudTd>
                    <MudTd>
                        <MudTooltip Text="Edit">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" Size="Size.Small" OnClick="() => Edit(context)" />
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => Delete(context)" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
    </MudItem>
</MudGrid>
}