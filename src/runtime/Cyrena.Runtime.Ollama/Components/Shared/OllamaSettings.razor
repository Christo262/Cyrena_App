<MudStack Row Justify="Justify.Center" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.h4">Ollama Connections</MudText>
    <MudSpacer/>
    <MudTooltip Text="Add">
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Small" OnClick="Create" />
    </MudTooltip>
</MudStack>

<MudTable Items="_models" Dense="true" Hover="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Model ID</MudTh>
        <MudTh>Endpoint</MudTh>
        <MudTh>Temperature</MudTh>
        <MudTh>

        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Model ID">@context.ModelId</MudTd>
        <MudTd DataLabel="Endpoint">@context.Endpoint</MudTd>
        <MudTd DataLabel="Temperature">@context.Temperature</MudTd>
        <MudTd>
            <MudTooltip Text="Edit">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => Edit(context)" />
            </MudTooltip>
            <MudTooltip Text="Delete">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
</MudTable>