@inject ISettingsService _settings
@inject ISnackbar _snackbar

<MudText Typo="Typo.h4">Tavily Web Search</MudText>
<MudAlert Severity="Severity.Success" Class="mb-4">
    <span class="text-danger">*</span> Gives Cyréna live web search. Get a free API key at <a href="https://tavily.com" target="_blank">tavily.com</a>.
</MudAlert>

<EditForm Model="_model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid Class="m-0">
        <MudItem xs="12" md="8" Class="mx-auto">
            <MudTextField @bind-Value="_model.ApiKey" Label="API Key" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-4" />

            <MudCheckBox @bind-Value="_model.Enable" Label="Enable" Class="mb-2" />
            <MudText Typo="Typo.caption" Class="text-muted">
                <span class="text-danger">*</span> Enable/Disable web search globally, even if feature is activated in a chat.
            </MudText>
        </MudItem>
        <MudItem xs="12" Class="text-center">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Save</MudButton>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private TavilyOptions _model = new();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _model = _settings.Read<TavilyOptions>(TavilyOptions.Key) ?? new TavilyOptions();
        this.StateHasChanged();
    }

    private void Submit()
    {
        if (_model == null) return;
        _settings.Save(TavilyOptions.Key, _model);
        _snackbar.Add("Settings Updated", Severity.Success);
    }
}
